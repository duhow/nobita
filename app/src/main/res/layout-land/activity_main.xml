<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/app_description" />

    <EditText android:id="@+id/target" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/capture_target_hint" />
    <Button android:id="@+id/choose_paired" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_paired" />
    <Button android:id="@+id/scan_nearby" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_nearby" />
    <Button android:id="@+id/choose_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_recent" />
    <CheckBox android:id="@+id/save_raw" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_raw" />
    <Button android:id="@+id/battery_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/battery_settings" />
    <Button android:id="@+id/start_capture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_capture" />
    <Button android:id="@+id/stop_export" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stop_export" android:visibility="gone" />
    <Button android:id="@+id/export_full" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/export_full" android:visibility="gone" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/export_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <Button android:id="@+id/open_capture" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/open_capture" />
        <Button android:id="@+id/share_capture" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/share_capture" />
    </LinearLayout>
</LinearLayout>
