<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/app_description" />

    <EditText android:id="@+id/target" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/capture_target_hint" />
    <Button android:id="@+id/start_capture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_capture" />
    <Button android:id="@+id/stop_export" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stop_export" android:visibility="gone" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
